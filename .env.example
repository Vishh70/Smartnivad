# ==============================================================================
# SmartNivad — Environment Configuration Template
# All secrets must remain strictly server-side. Use placeholders only.
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Direct)
# Note: percent-encode any special characters in [YOUR-PASSWORD]
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.jrsxsgwlzjihkkxwypac.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.jrsxsgwlzjihkkxwypac.supabase.co:5432/postgres"

# NextAuth Configuration
NEXTAUTH_SECRET="your-32-character-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Super Admin Credentials (Optional Initial Bootstrap)
SUPER_ADMIN_EMAIL="admin@smartnivad.com"
SUPER_ADMIN_PASSWORD_HASH="$2a$12$ExampleHashedPasswordPlaceholder..."

# Google OAuth (Optional Public Auth)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Scheduled Cron Security
# Required: CRON_SECRET is mandatory for /api/cron/* routes.
CRON_SECRET="your-secure-random-cron-secret-token"

# ==============================================================================
# Affiliate Data Providers (Official API Integrations)
# ==============================================================================

# Amazon Creators API (OAuth 2.0 Client Credentials)
# Regional Token Endpoint: https://api.amazon.co.uk/auth/o2/token (India marketplace)
# Catalog Endpoint: https://creatorsapi.amazon/catalog/v1/
AMAZON_CREATORS_CREDENTIAL_ID="your-creators-credential-id"
AMAZON_CREATORS_CREDENTIAL_SECRET="your-creators-credential-secret"
AMAZON_ASSOCIATE_TAG="smartnivad-21"
AMAZON_MARKETPLACE="www.amazon.in"
AMAZON_PROVIDER_PAUSED="false"
# Legacy fallback names (also supported for backward compatibility):
# AMAZON_ACCESS_KEY="your-creators-credential-id"
# AMAZON_SECRET_KEY="your-creators-credential-secret"

# Flipkart Affiliate Platform
FLIPKART_AFFILIATE_ID="smartnivad"
FLIPKART_AFFILIATE_TOKEN="your-flipkart-affiliate-token"
FLIPKART_PROVIDER_PAUSED="false"

# Social Queue Automation
SOCIAL_POSTING_ENABLED="false"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHANNEL_ID="@smartnivad"

# Cloud Media & AI Services
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
GEMINI_API_KEY="your-gemini-api-key"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="https://smartnivad.vercel.app"
