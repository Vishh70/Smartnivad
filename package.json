{
  "name": "smartnivad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:ci": "playwright test tests/e2e --reporter=html,line",
    "test:a11y": "playwright test tests/accessibility --project=chromium",
    "test:visual": "playwright test tests/visual --project=responsive-390 --project=responsive-768 --project=responsive-1440",
    "lhci": "lhci autorun",
    "bundle:analyze": "cross-env ANALYZE=true next build",
    "security:audit": "npm audit --audit-level=high",
    "qa": "run-s lint type-check test:coverage build",
    "seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "analyze": "cross-env ANALYZE=true npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.74.0",
    "@serwist/next": "^9.5.12",
    "@types/bcryptjs": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.2",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.11",
    "sharp": "^0.35.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.12.1",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "^16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.10"
  }
}
